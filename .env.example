# --- optional keys: the platform works without them, modules just return less data ---
# SHODAN_API_KEY=          # shodan.io  (IP ports/services)
# ABUSEIPDB_API_KEY=       # abuseipdb.com (IP reputation)
# HIBP_API_KEY=            # haveibeenpwned.com API v3 (breach data)
# CENSYS_API_TOKEN=        # Personal Access Token: platform.censys.io -> user icon -> API Access -> Create New Token
#                          # NOTE: free tier works with Lookup APIs only (host by IP, web property
#                          # by domain). The /search endpoint requires a PAID org — we use lookups.
# CENSYS_ORG_ID=           # OPTIONAL, paid orgs only. Free accounts: leave EMPTY.
# TELEGRAM_API_ID=         # my.telegram.org (Telegram public channel analysis)
# TELEGRAM_API_HASH=
# DNSDUMPSTER_API_KEY=   # official API key from https://dnsdumpster.com (dashboard, free tier)
# LEAKCHECK_API_KEY=     # OPTIONAL — LeakCheck Pro (paid, from $9.99/mo). NOT needed:
                         # the free keyless Public API is used automatically (sources + data categories).
